{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block main %}
<div class="container-fluid">
    <div class="row">
        <!-- SIDEBAR FIXE EN CLAIR -->
        <div class="col-md-3 bg-white border-end position-fixed vh-100 d-none d-md-block p-3 shadow-sm">
            <div class="text-center mb-4">
                <img src="https://i.pravatar.cc/100" class="rounded-circle border border-secondary shadow-sm" alt="avatar">
                <h5 class="mt-3 text-dark">{{ app.user.firstname|default('Utilisateur') }}</h5>
            </div>

            <div class="nav flex-column">
                <a href="{{ path('account_index') }}" class="nav-link text-dark {% if app.current_route == 'account_index' %}active bg-primary text-white fw-bold rounded{% endif %} mb-1">
                    <i class="fas fa-box me-2"></i> Mes Commandes
                </a>
                <a href="#" class="nav-link text-dark mb-1">
                    <i class="fas fa-map-marker-alt me-2"></i> Mes Adresses
                </a>
                <a href="{{ path('user_change_password') }}" class="nav-link text-dark {% if app.current_route == 'user_change_password' %}active bg-primary text-white fw-bold rounded{% endif %} mb-1">
                    <i class="fas fa-key me-2"></i> Changer le mot de passe
                </a>
                <hr>
                <a href="{{ path('user_logout') }}" class="nav-link text-danger fw-bold">
                    <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                </a>
            </div>
        </div>

        <!-- CONTENU PRINCIPAL -->
        <div class="col-md-9 offset-md-3 py-4">
            <div class="card shadow border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary">
                        <i class="fas fa-user-circle me-2"></i> Tableau de bord
                    </h5>
                    <span class="badge bg-success">Connecté</span>
                </div>
                <div class="card-body bg-light">
                    {% block main_account %}
                        <h4 class="mb-3">Mes Commandes</h4>
                        <p class="text-muted">Vous n'avez pas encore passé de commande.</p>
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
